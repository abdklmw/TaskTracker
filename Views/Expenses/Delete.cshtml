@using TaskTracker.Models.Expense
@model Expense
@{
    ViewData["Title"] = "Delete";
    var isInvoiced = Model.InvoicedDate.HasValue;
}
<h1>Delete</h1>
@if (isInvoiced)
{
    <div class="alert alert-warning">
        This expense has been invoiced and cannot be deleted.
    </div>
}
else
{
    <h3>Are you sure you want to delete this?</h3>
}
<div>
    <h4>Expense</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Client)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Client!.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.UnitAmount)
        </dt>
        <dd class="col-sm-10">
            $@Html.DisplayFor(model => model.UnitAmount)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Quantity)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Quantity)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TotalAmount)
        </dt>
        <dd class="col-sm-10">
            $@Html.DisplayFor(model => model.TotalAmount)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.InvoicedDate)
        </dt>
        <dd class="col-sm-10">
            @(Model.InvoicedDate.HasValue ? Model.InvoicedDate.Value.ToString("d") : "")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.InvoiceSent)
        </dt>
        <dd class="col-sm-10">
            @(Model.InvoiceSent.HasValue ? Model.InvoiceSent.Value.ToString("d") : "")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.PaidDate)
        </dt>
        <dd class="col-sm-10">
            @(Model.PaidDate.HasValue ? Model.PaidDate.Value.ToString("d") : "")
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="ExpenseID" />
        @if (!isInvoiced)
        {
            <input type="submit" value="Delete" class="btn btn-danger" />
            <span>|</span>
        }
        <a asp-action="Index">Back to List</a>
    </form>
</div>
