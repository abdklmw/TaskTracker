@using TaskTracker.Models.Invoice
@model InvoiceDetailsViewModel

@{
    ViewData["Title"] = $"Invoice {Model.InvoiceNumber}";
    var statusBadgeClass = Model.Status switch
    {
        InvoiceStatus.Paid => "bg-success",
        InvoiceStatus.Sent => "bg-primary",
        InvoiceStatus.Canceled => "bg-danger",
        _ => "bg-secondary"
    };
}

@await Html.PartialAsync("~/Views/Shared/_AlertsPartial.cshtml")

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="mb-1">
            Invoice #@Model.InvoiceNumber
            <span class="badge @statusBadgeClass fs-6 align-middle ms-2">@Model.Status</span>
        </h1>
        <div class="text-muted">@Model.ClientName</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Pdf" asp-route-id="@Model.InvoiceID" target="_blank" rel="noopener" class="btn btn-outline-primary">Preview PDF</a>
        <a asp-action="Index" class="btn btn-secondary">Back to Invoices</a>
    </div>
</div>

@if (Model.HasTotalMismatch)
{
    <div class="alert alert-warning">
        <strong>Total mismatch:</strong> The sum of line items ($@Model.ComputedTotalAmount.ToString("N2")) differs from the stored invoice total ($@Model.StoredTotalAmount.ToString("N2")).
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <div class="small text-muted">Invoice Date</div>
                <div class="fw-semibold">@Model.InvoiceDate.ToString("d")</div>
            </div>
            <div class="col-md-3">
                <div class="small text-muted">Sent Date</div>
                <div class="fw-semibold">@(Model.InvoiceSentDate.HasValue ? Model.InvoiceSentDate.Value.ToString("d") : "-")</div>
            </div>
            <div class="col-md-3">
                <div class="small text-muted">Paid Date</div>
                <div class="fw-semibold">@(Model.PaidDate.HasValue ? Model.PaidDate.Value.ToString("d") : "-")</div>
            </div>
            <div class="col-md-3">
                <div class="small text-muted">Invoice Total</div>
                <div class="fw-bold fs-5">$@Model.StoredTotalAmount.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

@if (!Model.TimeEntries.Any() && !Model.Expenses.Any())
{
    <div class="alert alert-info">No time entries or expenses recorded on this invoice.</div>
}

@if (Model.TimeEntries.Any())
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Time Entries</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Project</th>
                        <th>Description</th>
                        <th class="text-end">Hours</th>
                        <th class="text-end">Rate</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.TimeEntries)
                    {
                        <tr>
                            <td>@item.Date.ToString("d")</td>
                            <td>@item.ProjectName</td>
                            <td>@item.Description</td>
                            <td class="text-end">@item.Hours.ToString("F2")</td>
                            <td class="text-end">$@item.Rate.ToString("N2")</td>
                            <td class="text-end">$@item.LineTotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light fw-semibold">
                        <td colspan="3">Time Entries Subtotal</td>
                        <td class="text-end">@Model.TimeEntriesHoursTotal.ToString("F2")</td>
                        <td class="text-end">-</td>
                        <td class="text-end">$@Model.TimeEntriesSubtotal.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@if (Model.Expenses.Any())
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Expenses</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Expenses)
                    {
                        <tr>
                            <td>@item.Date.ToString("d")</td>
                            <td>@item.Description</td>
                            <td class="text-end">@item.Quantity</td>
                            <td class="text-end">$@item.UnitAmount.ToString("N2")</td>
                            <td class="text-end">$@item.LineTotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light fw-semibold">
                        <td colspan="4">Expenses Subtotal</td>
                        <td class="text-end">$@Model.ExpensesSubtotal.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<div class="card">
    <div class="card-body d-flex justify-content-end">
        <div style="min-width: 260px;">
            @if (Model.TimeEntries.Any())
            {
                <div class="d-flex justify-content-between mb-1">
                    <span>Time Entries Subtotal:</span>
                    <span>$@Model.TimeEntriesSubtotal.ToString("N2")</span>
                </div>
            }
            @if (Model.Expenses.Any())
            {
                <div class="d-flex justify-content-between mb-1">
                    <span>Expenses Subtotal:</span>
                    <span>$@Model.ExpensesSubtotal.ToString("N2")</span>
                </div>
            }
            <hr class="my-2" />
            <div class="d-flex justify-content-between fw-bold fs-5">
                <span>Invoice Total:</span>
                <span>$@Model.StoredTotalAmount.ToString("N2")</span>
            </div>
        </div>
    </div>
</div>
